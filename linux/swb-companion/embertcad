#!/usr/bin/env bash
set -u

APP_DIR="${AITCAD_APP_DIR:-$HOME/.local/share/aitcad/swb-companion}"
LOG_DIR="$HOME/.local/state/aitcad"
ENV_FILE="${AITCAD_ENV_FILE:-$HOME/.config/aitcad/environment}"
mkdir -p "$LOG_DIR"

if [[ -f "$ENV_FILE" ]]; then
  # Generated by install.sh. It contains only shell-quoted EmberTCAD paths.
  # shellcheck disable=SC1090
  source "$ENV_FILE"
fi

if [[ -z "${DISPLAY:-}" ]]; then
  echo "EmberTCAD needs a Linux graphical desktop (DISPLAY is empty)." >&2
  exit 1
fi

RUNNING_PID="$(pgrep -u "$(id -u)" -f '[n]ative_assistant(_gtk3)?\.py' | head -n 1 || true)"
if [[ -n "$RUNNING_PID" ]]; then
  if command -v wmctrl >/dev/null 2>&1; then
    wmctrl -a 'EmberTCAD' 2>/dev/null || true
  fi
  echo "EmberTCAD is already running (PID $RUNNING_PID)."
  exit 0
fi

ASSISTANT="$APP_DIR/native_assistant_gtk3.py"
if [[ ! -f "$ASSISTANT" ]]; then
  ASSISTANT="$APP_DIR/native_assistant.py"
fi

GTK_PYTHON="${AITCAD_GTK_PYTHON:-}"
if [[ -z "$GTK_PYTHON" ]]; then
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import gi; gi.require_version("Gtk", "3.0")' >/dev/null 2>&1; then
      GTK_PYTHON="$(command -v "$candidate")"
      break
    fi
  done
fi
if [[ -z "$GTK_PYTHON" ]]; then
  echo "EmberTCAD needs Python with GTK3/PyGObject. Run: $APP_DIR/install.sh --check" >&2
  exit 1
fi

nohup "$GTK_PYTHON" "$ASSISTANT" "$@" >>"$LOG_DIR/native-assistant.log" 2>&1 &
echo "EmberTCAD started (PID $!)."
